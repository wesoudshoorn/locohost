{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Locohost",
  "version": "3.0.0",
  "identifier": "com.locohost.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Locohost",
        "width": 420,
        "height": 200,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "decorations": false,
        "alwaysOnTop": true,
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["../build/icon.icns"],
    "resources": [
      "../server.js",
      "../lib/**/*",
      "../ui/**/*",
      "../install/**/*",
      "icons/tray-*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
