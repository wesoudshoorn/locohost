{
  "name": "locohost",
  "version": "2.1.0",
  "description": "Locohost - macOS menubar utility for tracking dev servers and system health",
  "type": "module",
  "scripts": {
    "setup": "node setup.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "install-agent": "bash install/install.sh",
    "uninstall-agent": "bash install/uninstall.sh",
    "icon": "node scripts/generate-app-icon.js",
    "dist": "tauri build",
    "test": "node --test 'test/*.test.js'"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1"
  },
  "keywords": [
    "localhost",
    "process",
    "tracker",
    "menubar",
    "macos",
    "health"
  ],
  "license": "MIT"
}
